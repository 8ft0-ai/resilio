{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resilio deployment.observed v1",
  "description": "Closed, bounded wire format. Sort evidence and compute event identity per Phase 5 Gate 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "service",
    "environment",
    "change",
    "deployment",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_type": {
      "const": "deployment.observed"
    },
    "service": {
      "$ref": "#/$defs/identity"
    },
    "environment": {
      "$ref": "#/$defs/identity"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release_id",
        "artifact_digest",
        "runtime"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "release_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "kind",
            "resource_id"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "$ref": "#/$defs/identifier"
            },
            "resource_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "$ref": "#/$defs/identifier"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "maxLength": 128
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
