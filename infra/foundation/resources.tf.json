{
  "resource": {
    "google_service_account": {
      "phase3_terraform_sentinel": {
        "account_id": "phase3-terraform-sentinel",
        "display_name": "Phase 3 Terraform sentinel",
        "description": "Non-privileged Resilio Phase 3 Terraform control-path sentinel.",
        "project": "resilio-reference-e882d4",
        "deletion_policy": "PREVENT"
      }
    },
    "google_project_service": {
      "control_cloudbuild": {
        "project": "resilio-control-e882d4",
        "service": "cloudbuild.googleapis.com",
        "disable_on_destroy": false
      },
      "control_artifactregistry": {
        "project": "resilio-control-e882d4",
        "service": "artifactregistry.googleapis.com",
        "disable_on_destroy": false
      },
      "control_containeranalysis": {
        "project": "resilio-control-e882d4",
        "service": "containeranalysis.googleapis.com",
        "disable_on_destroy": false
      },
      "control_containerscanning": {
        "project": "resilio-control-e882d4",
        "service": "containerscanning.googleapis.com",
        "disable_on_destroy": false
      },
      "control_logging": {
        "project": "resilio-control-e882d4",
        "service": "logging.googleapis.com",
        "disable_on_destroy": false
      },
      "reference_run": {
        "project": "resilio-reference-e882d4",
        "service": "run.googleapis.com",
        "disable_on_destroy": false
      }
    },
    "google_artifact_registry_repository": {
      "phase4": {
        "project": "resilio-control-e882d4",
        "location": "us-central1",
        "repository_id": "resilio-phase4",
        "description": "Resilio Phase 4 trusted supply-chain proof images.",
        "format": "DOCKER",
        "cleanup_policy_dry_run": false,
        "cleanup_policies": [
          {
            "id": "keep-recent-proof",
            "action": "KEEP",
            "most_recent_versions": [
              {
                "package_name_prefixes": [
                  "phase4-proof"
                ],
                "keep_count": 3
              }
            ]
          },
          {
            "id": "delete-old-proof",
            "action": "DELETE",
            "condition": [
              {
                "tag_state": "ANY",
                "package_name_prefixes": [
                  "phase4-proof"
                ],
                "older_than": "30d"
              }
            ]
          }
        ],
        "deletion_policy": "PREVENT",
        "depends_on": [
          "google_project_service.control_artifactregistry"
        ]
      }
    },
    "google_storage_bucket": {
      "phase4_evidence": {
        "project": "resilio-control-e882d4",
        "name": "resilio-control-e882d4-phase4-evidence",
        "location": "us-central1",
        "storage_class": "STANDARD",
        "uniform_bucket_level_access": true,
        "public_access_prevention": "enforced",
        "force_destroy": false,
        "versioning": [
          {
            "enabled": true
          }
        ],
        "soft_delete_policy": [
          {
            "retention_duration_seconds": 0
          }
        ],
        "lifecycle_rule": [
          {
            "action": [
              {
                "type": "Delete"
              }
            ],
            "condition": [
              {
                "age": 365,
                "with_state": "ANY"
              }
            ]
          }
        ],
        "deletion_policy": "PREVENT"
      }
    }
  }
}
